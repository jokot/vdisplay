upstream/client-desktop/**/Makefile.Release
upstream/client-desktop/**/release/
upstream/client-desktop/**/debug/
upstream/client-desktop/**/*.a
upstream/client-desktop/**/*.o
upstream/client-desktop/**/Info.plist-e
upstream/client-desktop/**/qml_qmlcache.qrc
